# AWS Configuration for DynamoDB
# Copy this file to .env.local and fill in your actual values

# AWS Region (required)
AWS_REGION=us-east-1

# AWS Credentials (choose one method)
# Method 1: Access Key and Secret Key
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Method 2: Session Token (if using temporary credentials)
# AWS_SESSION_TOKEN=your_session_token_here

# Method 3: Profile (if using AWS profiles)
# AWS_PROFILE=your_profile_name

# DynamoDB Table Names (optional - defaults are used if not specified)
# DYNAMODB_ORDERS_TABLE=inkhub-saved-views-orders
# DYNAMODB_PRODUCTS_TABLE=inkhub-saved-views-products

# Alternative: Use local DynamoDB for development
# DYNAMODB_ENDPOINT=http://localhost:8000
